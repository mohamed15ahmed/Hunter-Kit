PORT=4000
# Optional Cloudflare AI explanation service; active scanners do not require these credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct
# Optional: absolute path to Chrome/Edge/Chromium used by Visual Recon.
# HUNTERKIT_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional custom Nuclei template root (relative to this folder or absolute).
# Default: .tools/nuclei-templates, installed by npm run setup:templates.
# HUNTERKIT_TEMPLATES=.tools/nuclei-templates
# Optional per-Nuclei-process budget in milliseconds, range 1000..600000; default 180000.
# HUNTERKIT_SCAN_TIMEOUT_MS=180000
