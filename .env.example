PORT=4000
# Optional Cloudflare AI explanation service; active scanners do not require these credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3-8b-instruct
# Optional: absolute path to Chrome/Edge/Chromium used by Visual Recon.
# HUNTERKIT_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe

# Optional custom Nuclei template root (relative to this folder or absolute).
# Default: .tools/nuclei-templates, installed by npm run setup:templates.
# HUNTERKIT_TEMPLATES=.tools/nuclei-templates
# Optional per-Nuclei/Dalfox-process budget in milliseconds, range 1000..600000; default 180000.
# HUNTERKIT_SCAN_TIMEOUT_MS=180000
# Native attack and Node discovery proxy. Leave unset to use proxy environment variables
# or a static Windows user proxy. PAC scripts are not executed automatically.
# HUNTERKIT_PROXY=http://127.0.0.1:8080
# Set HUNTERKIT_PROXY=direct only when a direct connection is intended.
# Per-request attack timeout in seconds, range 3..60; default 15.
# HUNTERKIT_REQUEST_TIMEOUT_SECONDS=15
